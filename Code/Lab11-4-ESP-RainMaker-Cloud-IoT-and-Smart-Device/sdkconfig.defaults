# ESP RainMaker Smart Light (Lab 11-4)
# BLE provisioning (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# RainMaker needs the "fctry" NVS partition and does not fit the default 1 MB app partition
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Larger main task stack for RainMaker / TLS
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
