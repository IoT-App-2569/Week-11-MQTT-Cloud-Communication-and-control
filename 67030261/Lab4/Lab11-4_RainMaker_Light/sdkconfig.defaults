CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table (มี esp_secure_cert / fctry สำหรับ Assisted Claiming)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb_optimised.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xc000

# mbedtls
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# BLE Provisioning (NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ENABLED=y

CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3120

# ให้ใช้ app_wifi_init() / app_wifi_start() ตามโค้ดในใบงานได้
CONFIG_APP_WIFI_PROV_COMPAT=y

# NimBLE host task ตอบ challenge-response (ECDSA) ตอน Node Association ต้องใช้ stack มากกว่า 4096
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
